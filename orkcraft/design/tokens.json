{
  "version": 1,
  "about": "The design tokens of orkcraft (docs/design-system.md). Roles, never raw values, appear in a building's UI document; each face maps a role to what it can draw.",
  "fonts": {
    "title":   {"about": "a building's name, a dialog's heading",          "family": "display", "size": 18, "weight": 700, "tui": "bold"},
    "heading": {"about": "a pane's or a section's heading",                "family": "display", "size": 15, "weight": 600, "tui": "bold"},
    "body":    {"about": "running text: notes, Markdown, descriptions",    "family": "text",    "size": 14, "weight": 400, "tui": ""},
    "mono":    {"about": "code, diffs, paths, terminals, the editor",      "family": "mono",    "size": 13, "weight": 400, "tui": ""},
    "status":  {"about": "the short live lines: what runs, what waits",    "family": "text",    "size": 12, "weight": 400, "tui": ""},
    "label":   {"about": "a field's or a column's name, a key on a button", "family": "text",   "size": 12, "weight": 600, "tui": "bold dim"},
    "number":  {"about": "a counter, money, tokens, a percentage",         "family": "mono",    "size": 14, "weight": 600, "tui": "bold"}
  },
  "families": {
    "camp":   {"display": "\"Cinzel\", \"Trajan Pro\", Georgia, serif",
               "text": "\"Alegreya Sans\", \"Segoe UI\", system-ui, sans-serif",
               "mono": "\"JetBrains Mono\", \"Cascadia Code\", Menlo, monospace"},
    "office": {"display": "\"Inter\", \"Segoe UI\", system-ui, sans-serif",
               "text": "\"Inter\", \"Segoe UI\", system-ui, sans-serif",
               "mono": "\"JetBrains Mono\", \"Cascadia Code\", Menlo, monospace"}
  },
  "colors": {
    "about": {
      "canvas": "the town's ground, behind everything",
      "surface": "the inside of a window",
      "frame": "a window's or a pane's border",
      "frame_focus": "the border of what is selected",
      "text": "ordinary text",
      "muted": "what matters less: hints, timestamps, status lines",
      "accent": "what invites a click: the selected row, a key",
      "ok": "done, passed, healthy",
      "wait": "running, queued, waiting for a turn",
      "fire": "a question waits for the person (an ork's hut on fire)",
      "error": "failed, refused, broken",
      "road": "a road at rest",
      "road_selected": "the selected road",
      "harness.claude": "an ork that runs on Claude Code",
      "harness.agy": "an ork that runs on Antigravity",
      "harness.codex": "an ork that runs on Codex",
      "harness.pipeline": "a pipeline of several orks"
    },
    "camp": {
      "canvas": "#0a130c", "surface": "#0e1611", "frame": "#3e6b48", "frame_focus": "#c99a3e",
      "text": "#e6e1cf", "muted": "#8a8f87", "accent": "#c99a3e",
      "ok": "#98c379", "wait": "#e5c07b", "fire": "#ff8c1a", "error": "#e06c75",
      "road": "#5c4326", "road_selected": "#d9a066",
      "harness.claude": "#f59e0b", "harness.agy": "#3b82f6", "harness.codex": "#10a37f", "harness.pipeline": "#e879f9"
    },
    "office": {
      "canvas": "#000000", "surface": "#000000", "frame": "#7a7a7a", "frame_focus": "#d4d4d4",
      "text": "#e5e5e5", "muted": "#9a9a9a", "accent": "#d4d4d4",
      "ok": "#4ade80", "wait": "#facc15", "fire": "#ef4444", "error": "#ef4444",
      "road": "#5a5a5a", "road_selected": "#d4d4d4",
      "harness.claude": "#f59e0b", "harness.agy": "#3b82f6", "harness.codex": "#10a37f", "harness.pipeline": "#e879f9"
    }
  },
  "space": {
    "about": "Steps of space between and inside panes: px for a GUI, terminal cells for the TUI.",
    "px":    [0, 4, 8, 12, 16, 24, 32],
    "cells": [0, 0, 1, 1, 1, 2, 2]
  }
}
