{
  "type": "watchtower",
  "about": "🗼 Watchtower: what comes in from outside — the sources with what is new in each, a source's feed, the item read in full, and what to listen for.",
  "panes": {
    "sources": {
      "about": "every source with what is new in it and its state; a failing one says why",
      "components": [
        "status",
        "list"
      ],
      "required": true
    },
    "feed": {
      "about": "the chosen source's signals (or all of them), new ones marked; on the settings tab the sources and the intent",
      "components": [
        "list",
        "form"
      ],
      "required": true
    },
    "item": {
      "about": "the signal read in full",
      "components": [
        "markdown",
        "text"
      ],
      "required": true
    }
  },
  "default": {
    "version": 1,
    "type": "watchtower",
    "split": "column",
    "panes": [
      {
        "id": "sources",
        "component": "status",
        "size": "auto",
        "font": "status"
      },
      {
        "split": "row",
        "size": 1,
        "panes": [
          {
            "id": "feed",
            "component": "list",
            "size": 2,
            "font": "body"
          },
          {
            "id": "item",
            "component": "markdown",
            "size": 3,
            "font": "body"
          }
        ]
      }
    ]
  }
}
